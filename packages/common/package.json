{
  "name": "@quizzem/common",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p ./tsconfig.json",
    "generate-classes": "pnpm exec tsx src/scripts/generate.ts",
    "generate": "pnpm generate-classes && pnpm exec prettier --write ./src/__generated__/generated.ts",
    "prettier": "pnpm exec prettier --write ."
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "ts-morph": "^24.0.0",
    "tsx": "^4.20.3"
  }
}
